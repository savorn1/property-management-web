# Origin of the property-management backend. It has no CORS config, so
# requests never go there directly from the browser — Nitro's routeRules
# proxy /api/** to this origin server-side instead (see nuxt.config.ts).
# Not exposed to the client.
NUXT_BACKEND_BASE=http://localhost:8901

# Port this app's own dev server listens on.
NUXT_PORT=3006
